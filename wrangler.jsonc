{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenbu",
  "account_id": "48d9ccaf5ee7914c803b5d0656462848",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/"],
  },
  "vars": {
    "SITE_URL": "https://wenbu.genedai.me",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "AI_DAILY_LIMIT": "1000",
    "AI_PER_USER_DAILY_LIMIT": "5",
    "AGENT_PER_USER_DAILY_LIMIT": "12",
    "AGENT_GLOBAL_DAILY_LIMIT": "600",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "UsageGate",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsageGate"],
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": false,
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wenbu.genedai.me",
      "custom_domain": true,
    },
  ],
}

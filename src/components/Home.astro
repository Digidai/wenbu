---
import Instrument from './Instrument.astro';
import ArticleCard from './ArticleCard.astro';
import { articles } from '../data/articles';
import { choose, href, toolInfo } from '../lib/i18n';
import type { Locale, ToolKind } from '../lib/schema';
const { locale } = Astro.props as { locale: Locale };
const t = (zh: string, en: string) => choose(locale, zh, en);
---

<div class="shell">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow accent">
        <i class="small-dot"></i>AN OPEN DOOR TO ANCIENT WISDOM
      </span>
      <h1>
        {locale === 'zh' ? (
          <>
            把心里的问题，
            <br />
            <em>看得更清楚。</em>
          </>
        ) : (
          <>
            Bring your question.
            <br />
            <em>Find a fresh perspective.</em>
          </>
        )}
      </h1>
      <p class="hero-description">
        {t(
          '免费排八字与紫微命盘、抽塔罗、问易经。也可以直接与 Agent 对话，让它调用工具、查阅资料，把结果和出处放在一起。',
          'Calculate a birth chart, draw tarot or cast the I Ching for free. Or ask Wenbu Agent to use the tools, read references and bring the results together.',
        )}
      </p>
      <div class="hero-buttons">
        <a class="button vermillion" data-track="hero-agent" href={href(locale, 'agent')}>
          {t('带着问题开始对话', 'Start with your question')}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" data-track="hero-chart" href={href(locale, 'bazi')}>
          {t('直接免费排盘', 'Go straight to a chart')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-meta">
        <span>{t('无需注册', 'NO ACCOUNT')}</span>
        <span>{t('工具免费', 'FREE TO EXPLORE')}</span>
        <span>{t('计算有依据', 'METHODS YOU CAN CHECK')}</span>
      </div>
    </div>
    <div class="hero-visual">
      <Instrument />
      <div class="visual-caption">{t('天地有序 · 万物有时', 'EVERYTHING HAS ITS SEASON')}</div>
    </div>
  </section>
  <a class="home-agent-entry" data-track="home-agent" href={href(locale, 'agent')}>
    <span class="home-agent-mark">问</span>
    <span>
      <small>WENBU AGENT · {t('独立研习室', 'THE RESEARCH STUDIO')}</small>
      <strong>
        {t('命盘、图解与出处，放进同一段对话。', 'Charts, visual notes and sources, in one conversation.')}
      </strong>
    </span>
    <span class="home-agent-cta">{t('与命理 Agent 对话', 'Meet Wenbu Agent')} ↗</span>
  </a>
  <div class="almanac-strip">
    <div class="almanac-mark">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width=".8" aria-hidden="true">
        <circle cx="20" cy="20" r="10" />
        <path d="M20 0v6m0 28v6M0 20h6m28 0h6M6 6l5 5m18 18 5 5M6 34l5-5M29 11l5-5" />
      </svg>
      <span>{t('留白一刻', 'A QUIET THOUGHT')}</span>
    </div>
    <p>{t('不急着知道答案，先听清自己的问题。', 'Before finding an answer, listen to the question.')}</p>
    <span class="small-label">{t('问卜 · 日常灵感', 'WENBU · A DAILY PRACTICE')}</span>
  </div>
  <section class="section reveal" id="explore">
    <div class="section-heading">
      <div>
        <span class="eyebrow">FOUR WAYS TO LOOK WITHIN</span>
        <h2>{t('一问之间，换个角度。', 'One question. A different perspective.')}</h2>
      </div>
      <p>
        {t(
          '选择一种方式，给心里的事情一个新的入口。',
          'Choose a tradition. Give what is on your mind a new place to begin.',
        )}
      </p>
    </div>
    <div class="tool-grid">
      {(Object.keys(toolInfo) as ToolKind[]).map((kind, i) => {
        const tool = toolInfo[kind];
        return (
          <a class={`tool-card ${tool.color}`} href={href(locale, kind)}>
            <div class="tool-card-top">
              <span>
                0{i + 1} / {['BAZI', 'I CHING', 'TAROT', 'ZI WEI'][i]}
              </span>
              <span>↗</span>
            </div>
            <div class="tool-icon" aria-hidden="true">
              {kind === 'bazi' ? (
                <div class="mini-pillar">
                  {['甲\n子', '丙\n寅', '辛\n酉', '壬\n辰'].map((p) => (
                    <span>
                      {p.split('\n')[0]}
                      <br />
                      {p.split('\n')[1]}
                    </span>
                  ))}
                </div>
              ) : kind === 'iching' ? (
                <div class="mini-hex">
                  {[1, 0, 1, 0, 1, 0].map((b) => (
                    <div>
                      {b ? (
                        <i />
                      ) : (
                        <>
                          <i />
                          <i />
                        </>
                      )}
                    </div>
                  ))}
                </div>
              ) : kind === 'tarot' ? (
                <img
                  class="mini-tarot-art"
                  src="/images/tarot/17-star.webp"
                  width="70"
                  height="105"
                  alt=""
                  loading="lazy"
                />
              ) : (
                <div class="mini-star">✳</div>
              )}
            </div>
            <h3>{t(tool.zh, tool.en)}</h3>
            <p>{t(tool.descriptionZh, tool.descriptionEn)}</p>
            <div class="tool-card-bottom">
              <span>
                {t(
                  ['出生的五行底色', '变化中的一束光', '一场直觉的相遇', '十二宫的人生地图'][i],
                  [
                    'YOUR ELEMENTAL PALETTE',
                    'THE LANGUAGE OF CHANGE',
                    'A MOMENT OF INTUITION',
                    'A TWELVE-PALACE MAP',
                  ][i],
                )}
              </span>
              <span>↗</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
  <section class="deck-editorial reveal" aria-labelledby="deck-heading">
    <div class="deck-editorial-art" aria-hidden="true">
      <img src="/images/tarot/02-high-priestess.webp" width="180" height="270" alt="" loading="lazy" />
      <img src="/images/tarot/17-star.webp" width="180" height="270" alt="" loading="lazy" />
      <img src="/images/tarot/19-sun.webp" width="180" height="270" alt="" loading="lazy" />
    </div>
    <div>
      <span class="eyebrow accent">THE WENBU DECK · 78 ILLUSTRATIONS</span>
      <h2 id="deck-heading">{t('让一个画面，打开另一种看法。', 'A picture. Another way to see.')}</h2>
      <p>
        {t(
          '78 张原创 AI 插画，重新描绘传统塔罗意象。抽一张整理思绪，或用三张牌看见当下、牵引与下一步。每张牌都可以放大细看。',
          '78 original AI illustrations reinterpret traditional tarot imagery. Draw one card for reflection, or three for the situation, tension and next step. Open any card to look closer.',
        )}
      </p>
      <a class="text-link" data-track="tool-entry" href={href(locale, 'tarot/deck')}>
        {t('翻阅完整 78 张牌', 'Explore all 78 cards')} →
      </a>
    </div>
  </section>
  <div class="home-proof-row">
    <a href={href(locale, 'methodology')}>
      <strong>{t('计算与解释分开', 'Calculations come first')}</strong>
      <span>
        {t(
          '四柱、星盘与抽牌由工具产生；解释标明依据与边界。',
          'Tools produce the chart or draw. Interpretations state their scope.',
        )}
      </span>
    </a>
    <a href={href(locale, 'free')}>
      <strong>{t('免费额度公开', 'Clear free allowances')}</strong>
      <span>
        {t(
          '无需注册。AI 解读每天 5 次，Agent 每天 12 回合，按网络计数。',
          'No account. Five AI readings and 12 Agent turns per network each day.',
        )}
      </span>
    </a>
    <a href={href(locale, 'privacy')}>
      <strong>{t('资料由你选择', 'You choose the context')}</strong>
      <span>
        {t(
          '会话与手记留在本机；发送前可查看会分享什么。',
          'Conversations and journals stay in this browser. You choose what to share.',
        )}
      </span>
    </a>
  </div>
  <section class="manifesto reveal">
    <div>
      <span class="eyebrow accent">A MIRROR, NOT A VERDICT</span>
      <h2>
        {locale === 'zh' ? (
          <>
            借古人的眼光，
            <br />
            看见<em>自己的可能。</em>
          </>
        ) : (
          <>
            An old language.
            <br />
            <em>Your own meaning.</em>
          </>
        )}
      </h2>
    </div>
    <div class="manifesto-items">
      {[
        [
          t('看得见的依据', 'A basis you can see'),
          t(
            '先呈现命盘和符号，再说它们意味着什么。计算规则与来源，始终可以查看。',
            'See the chart and symbols before the story. Calculation conventions and sources are always within reach.',
          ),
        ],
        [
          t('留得住的思考', 'A thought you can return to'),
          t(
            '把有共鸣的瞬间记下来，过些时候再读。手记只在你自己的浏览器里。',
            'Save a moment that resonates and revisit it later. Your journal lives in your own browser.',
          ),
        ],
        [
          t('由你决定的下一步', 'A next step that belongs to you'),
          t(
            '不替你给人生下定论。把解读当作一个问题，把选择留给真实生活里的你。',
            'Take a reading as a question to consider. The choices and the life around them remain yours.',
          ),
        ],
      ].map(([title, body], i) => (
        <div class="manifesto-item">
          <span>0{i + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section reveal">
    <div class="section-heading">
      <div>
        <span class="eyebrow">THE WENBU LIBRARY</span>
        <h2>{t('不止读懂结果，也读懂来由。', 'Understand the why behind the reading.')}</h2>
      </div>
      <a class="text-link" href={href(locale, 'learn')}>
        {t('翻开知识手册', 'Explore the library')} ↗
      </a>
    </div>
    <div class="article-grid">
      {[articles[0], articles[3], articles[6]].map((article) => (
        <ArticleCard article={article} locale={locale} />
      ))}
    </div>
  </section>
  <section class="agent-banner reveal">
    <div>
      <span class="eyebrow">FOR THE AGENTS IN YOUR LIFE</span>
      <h2>{t('把理解带走，把对话继续。', 'Take the context. Continue the conversation.')}</h2>
      <p>
        {t(
          '你的命盘，可以成为下一次对话的起点。通过 MCP、CLI 或 Skill，与你自己的 Agent 一起探索。',
          'Your chart can become the starting point for another conversation. Bring it to your agent through MCP, CLI or a Skill.',
        )}
      </p>
      <a class="text-link" href={href(locale, 'agents')}>
        {t('连接我的 Agent', 'Connect your agent')} ↗
      </a>
    </div>
    <div class="agent-terminal">
      <div class="terminal-dots">
        <i />
        <i />
        <i />
      </div>
      <div>
        <span class="prompt">$</span> node wenbu.mjs bazi --file birth.json
      </div>
      <div class="output">{`{ "kind": "bazi",`}</div>
      <div class="output">{`  "pillars": [ … ],`}</div>
      <div class="output">{`  "method": { "engine": "lunar-typescript" } }`}</div>
      <div>
        <span class="prompt">✓</span> {t('依据清楚，上下文由你选择。', 'Clear methods. Context you choose.')}
      </div>
    </div>
  </section>
</div>

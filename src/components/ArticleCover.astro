---
import type { Article } from '../data/articles';
import { coverForArticle } from '../data/article-covers';
import '../styles/article-covers.css';
const { article } = Astro.props as { article: Article };
const cover = coverForArticle(article.slug);
const point = (angle: number, radius: number) => ({
  x: 438 + Math.cos((angle * Math.PI) / 180) * radius,
  y: 160 + Math.sin((angle * Math.PI) / 180) * radius,
});
const elementPoints = Array.from({ length: 5 }, (_, i) => point(-90 + i * 72, 72));
const palaceCells = Array.from({ length: 16 }, (_, i) => ({ x: i % 4, y: Math.floor(i / 4) })).filter(
  ({ x, y }) => x === 0 || x === 3 || y === 0 || y === 3,
);
---

<div class:list={['article-cover', `cover-${cover.tone}`, `cover-${cover.motif}`]} aria-hidden="true">
  <svg class="cover-drawing" viewBox="0 0 600 320" fill="none" focusable="false">
    <g class="cover-orbits">
      <circle cx="210" cy="160" r="123" />
      <circle cx="326" cy="160" r="123" />
      <path d="M22 40V22h18M560 22h18v18M22 280v18h18M560 298h18v-18" />
      <path d="M34 266h47M519 54h47" />
      <circle cx="91" cy="266" r="2" />
    </g>
    <g class="cover-motif" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {cover.motif === 'compass' && (
        <>
          <circle cx="438" cy="160" r="73" />
          <circle cx="438" cy="160" r="61" class="cover-faint" />
          <path d="M438 77v16m0 134v16M355 160h16m134 0h16" />
          <path d="m468 108-17 65-43 39 17-65Z" />
          <path d="m468 108-43 39 26 26Z" class="cover-wash" />
          <circle cx="438" cy="160" r="7" />
        </>
      )}
      {cover.motif === 'question' && (
        <>
          <path d="M383 105h112v75h-58l-32 24v-24h-22Z" />
          <path d="M372 133h-13v83h58l24 20v-20h33v-19" class="cover-faint" />
          <circle cx="414" cy="143" r="3" />
          <circle cx="438" cy="143" r="3" />
          <circle cx="462" cy="143" r="3" />
          <path d="m488 88 10-15m11 28 18-3" class="cover-faint" />
        </>
      )}
      {cover.motif === 'calendar' && (
        <>
          <rect x="374" y="91" width="128" height="140" rx="3" />
          <path
            d="M374 126h128M401 79v24m74-24v24M400 153h76M400 179h76M400 205h76M417 144v71m28-71v71"
            class="cover-faint"
          />
          <circle cx="459" cy="178" r="17" />
          <path d="m452 178 5 5 10-12" />
        </>
      )}
      {cover.motif === 'pillars' && (
        <>
          {[0, 1, 2, 3].map((i) => (
            <g opacity={i === 2 ? 1 : 0.65}>
              <rect x={365 + i * 39} y="99" width="28" height="125" rx="1" />
              <path d={`M${365 + i * 39} 162h28M${372 + i * 39} 197h14`} />
              <circle cx={379 + i * 39} cy="131" r="7" />
            </g>
          ))}
          <path d="M355 239h174M365 85h145" class="cover-faint" />
        </>
      )}
      {cover.motif === 'elements' && (
        <>
          <circle cx="438" cy="160" r="72" class="cover-faint" />
          <polygon points={elementPoints.map((p) => `${p.x},${p.y}`).join(' ')} />
          <path
            d={`M${elementPoints[0].x} ${elementPoints[0].y} ${[2, 4, 1, 3, 0].map((i) => `L${elementPoints[i].x} ${elementPoints[i].y}`).join(' ')}`}
            class="cover-faint"
          />
          {elementPoints.map((p, i) => (
            <circle cx={p.x} cy={p.y} r={i === 0 ? 10 : 7} class="cover-node" />
          ))}
        </>
      )}
      {cover.motif === 'clock' && (
        <>
          <circle cx="438" cy="160" r="74" />
          <circle cx="438" cy="160" r="63" class="cover-faint" />
          <ellipse cx="438" cy="160" rx="36" ry="74" class="cover-faint" />
          {Array.from({ length: 12 }, (_, i) => {
            const a = point(i * 30, 66),
              b = point(i * 30, 73);
            return <path d={`M${a.x} ${a.y}L${b.x} ${b.y}`} />;
          })}
          <path d="M438 111v49l35 21" />
          <circle cx="438" cy="160" r="4" class="cover-node" />
          {article.slug === 'unknown-birth-time' && (
            <path d="M362 92 514 231" stroke-dasharray="3 6" class="cover-faint" />
          )}
        </>
      )}
      {cover.motif === 'hexagram' && (
        <>
          <circle cx="438" cy="160" r="91" class="cover-faint" />
          {[false, true, false, true, false, true].map((solid, i) => (
            <path
              d={solid ? `M390 ${108 + i * 21}h96` : `M390 ${108 + i * 21}h38m20 0h38`}
              stroke-width="6"
              stroke-linecap="butt"
            />
          ))}
          <circle cx="354" cy="252" r="12" />
          <rect x="351" y="249" width="6" height="6" />
          <circle cx="384" cy="264" r="12" />
          <rect x="381" y="261" width="6" height="6" />
          <circle cx="414" cy="252" r="12" />
          <rect x="411" y="249" width="6" height="6" />
        </>
      )}
      {cover.motif === 'trigrams' && (
        <>
          <circle cx="438" cy="160" r="39" class="cover-faint" />
          {[5, 0, 3, 7, 2, 4, 1, 6].map((bits, i) => (
            <g transform={`rotate(${i * 45} 438 160)`}>
              {[0, 1, 2].map((j) => (
                <path
                  d={(bits >> (2 - j)) & 1 ? `M424 ${74 + j * 9}h28` : `M424 ${74 + j * 9}h11m6 0h11`}
                  stroke-width="3"
                  stroke-linecap="butt"
                />
              ))}
            </g>
          ))}
        </>
      )}
      {cover.motif === 'palaces' && (
        <>
          {palaceCells.map(({ x, y }, i) => (
            <g>
              <rect x={360 + x * 39} y={82 + y * 39} width="39" height="39" />
              <circle cx={379 + x * 39} cy={101 + y * 39} r={i % 3 === 0 ? 3 : 1.5} class="cover-node" />
            </g>
          ))}
          <path d="m438 140 4 15 16 5-16 4-4 16-4-16-16-4 16-5Z" />
        </>
      )}
      {cover.motif === 'transformations' && (
        <>
          <circle cx="438" cy="160" r="65" class="cover-faint" />
          {[0, 1, 2, 3].map((i) => {
            const p = point(-90 + i * 90, 65);
            return (
              <g>
                <path d={`M438 160L${p.x} ${p.y}`} class="cover-faint" />
                <circle cx={p.x} cy={p.y} r="15" class="cover-node" />
                <circle cx={p.x} cy={p.y} r="5" />
              </g>
            );
          })}
          <path d="m438 146 14 14-14 14-14-14Z" />
        </>
      )}
      {cover.motif === 'relations' && (
        <>
          <circle cx="438" cy="160" r="74" class="cover-faint" />
          {Array.from({ length: 10 }, (_, i) => {
            const p = point(-90 + i * 36, 74);
            return (
              <g>
                <path d={`M438 160L${p.x} ${p.y}`} class="cover-faint" />
                <circle cx={p.x} cy={p.y} r={i % 2 ? 5 : 8} class="cover-node" />
              </g>
            );
          })}
          <circle cx="438" cy="160" r="21" class="cover-node" />
          <path d="M428 160h20m-10-10v20" />
        </>
      )}
      {cover.motif === 'notes' && (
        <>
          <path d="M438 119q-39-26-77-7v116q39-16 77 7 39-23 77-7V112q-39-19-77 7Z" />
          <path
            d="M438 119v116M374 139q24-7 48 7m-48 12q24-7 48 7m-48 12q24-7 48 7m32-38q24-14 48-7m-48 26q24-14 48-7m-48 26q24-14 48-7"
            class="cover-faint"
          />
          <path d="M474 106V78h19v37l-9-7-10 5" />
        </>
      )}
      {cover.motif === 'sources' && (
        <>
          <path d="M379 108V87h104l18 19v105h-24" class="cover-faint" />
          <path d="M362 110h103l17 19v107H362Z" />
          <path d="M465 110v22h17M379 155h66m-66 16h66m-66 16h41" class="cover-faint" />
          <circle cx="479" cy="215" r="29" />
          <path d="m500 236 21 21M469 215h20m-10-10v20" />
        </>
      )}
      {cover.motif === 'compare' && (
        <>
          <circle cx="412" cy="160" r="57" />
          <circle cx="463" cy="160" r="57" />
          <path d="M380 147h25m-25 13h25m-25 13h25" />
          <path d="m485 142 4 13 14 5-14 4-4 14-4-14-14-4 14-5Z" />
          <path d="M438 85v150" stroke-dasharray="2 7" class="cover-faint" />
        </>
      )}
    </g>
  </svg>
  <span class="cover-symbol">{article.symbol}</span>
  {cover.cards && (
    <div class="cover-cards">
      {cover.cards.map((card, i) => (
        <img
          class:list={['cover-card-image', { 'is-reversed': cover.reversed && i === 1 }]}
          src={`/images/tarot/${card}-small.webp`}
          alt=""
          width="260"
          height="390"
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  )}
</div>
